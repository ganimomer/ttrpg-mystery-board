# ─── Discord OAuth ───────────────────────────────────────────────
# Create an application at https://discord.com/developers/applications
# OAuth2 → add redirect: http://localhost:8787/api/auth/discord/callback
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:8787/api/auth/discord/callback

# Same value as DISCORD_CLIENT_ID, exposed to the client build so it can run as
# a Discord Activity (the Embedded App SDK needs the client id in the browser).
VITE_DISCORD_CLIENT_ID=your_discord_client_id

# ─── Sessions ────────────────────────────────────────────────────
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# ─── Database ────────────────────────────────────────────────────
# Postgres connection string. Use the docker-compose.yml for local dev.
DATABASE_URL=postgres://board:board@localhost:5432/board

# ─── Server ──────────────────────────────────────────────────────
PORT=8787
# Public origin of the app (used to build OAuth + invite links).
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
