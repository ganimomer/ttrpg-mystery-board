# ─── Discord OAuth ───────────────────────────────────────────────
# Create an application at https://discord.com/developers/applications
# OAuth2 → add redirect: http://localhost:8787/api/auth/discord/callback
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:8787/api/auth/discord/callback

# ─── Game Masters ────────────────────────────────────────────────
# Comma-separated Discord user IDs allowed to create boards & upload.
# To find yours: Discord → Settings → Advanced → enable Developer Mode,
# then right-click your name → "Copy User ID".
GM_DISCORD_IDS=123456789012345678

# ─── Sessions ────────────────────────────────────────────────────
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# ─── Server ──────────────────────────────────────────────────────
PORT=8787
# Public origin of the app (used to build OAuth + invite links).
APP_ORIGIN=http://localhost:5173
# Where SQLite db and uploaded images live (created if missing).
DATA_DIR=./data
# Max upload size in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760
NODE_ENV=development
